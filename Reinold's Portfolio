<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Reinold Ras — Certified Healthcare Virtual Assistant, Medical Scheduler, and Healthcare Customer Service Specialist.">

  <title>Reinold Ras | Certified Healthcare Virtual Assistant</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --navy: #12213a;
      --blue: #176b87;
      --light-blue: #eaf5f8;
      --text: #334155;
      --muted: #64748b;
      --border: #dce4eb;
      --white: #ffffff;
      --light: #f7fafc;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--white);
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    /* NAVIGATION */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--navy);
    }

    .logo span {
      color: var(--blue);
    }

    nav {
      display: flex;
      gap: 28px;
      font-size: 14px;
      font-weight: 600;
    }

    nav a:hover {
      color: var(--blue);
    }

    /* HERO */

    .hero {
      background:
        linear-gradient(135deg, #f7fbfd 0%, #ffffff 65%);
      padding: 110px 0 90px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.4fr .6fr;
      gap: 70px;
      align-items: center;
    }

    .eyebrow {
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 3px;
      margin-bottom: 18px;
    }

    h1 {
      font-family: Georgia, "Times New Roman", serif;
      color: var(--navy);
      font-size: clamp(46px, 6vw, 72px);
      line-height: 1.05;
      margin-bottom: 25px;
    }

    .hero-description {
      font-size: 19px;
      color: var(--muted);
      max-width: 700px;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .button {
      padding: 13px 24px;
      border-radius: 6px;
      font-weight: 700;
      display: inline-block;
      transition: .2s;
    }

    .button-primary {
      background: var(--blue);
      color: white;
    }

    .button-primary:hover {
      transform: translateY(-2px);
      opacity: .9;
    }

    .button-secondary {
      border: 1px solid var(--border);
      background: white;
      color: var(--navy);
    }

    .availability {
      margin-top: 22px;
      color: var(--muted);
      font-size: 14px;
    }

    .dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #28a745;
      margin-right: 7px;
    }

    /* PROFILE CARD */

    .profile-card {
      background: white;
      border: 1px solid var(--border);
      padding: 35px;
      border-radius: 12px;
      box-shadow: 0 20px 50px rgba(18,33,58,.09);
    }

    .profile-card small {
      color: var(--blue);
      font-weight: 800;
      letter-spacing: 2px;
    }

    .profile-card h2 {
      font-family: Georgia, serif;
      color: var(--navy);
      font-size: 32px;
      margin: 12px 0;
    }

    .profile-card p {
      color: var(--muted);
      font-size: 14px;
    }

    .stats {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .stat {
      display: flex;
      justify-content: space-between;
      margin: 13px 0;
    }

    .stat strong {
      color: var(--blue);
      font-size: 21px;
    }

    .stat span {
      color: var(--muted);
      font-size: 13px;
      text-align: right;
    }

    /* SECTIONS */

    section {
      padding: 90px 0;
    }

    .gray {
      background: var(--light);
    }

    .section-label {
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 3px;
      margin-bottom: 12px;
    }

    section h2 {
      font-family: Georgia, serif;
      color: var(--navy);
      font-size: 42px;
      line-height: 1.2;
      margin-bottom: 25px;
    }

    .two-column {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 80px;
    }

    .about-text p {
      margin-bottom: 18px;
      color: var(--muted);
      font-size: 16px;
    }

    /* SERVICES */

    .cards {
      margin-top: 40px;
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 18px;
    }

    .card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px;
      min-height: 240px;
    }

    .number {
      color: var(--blue);
      background: var(--light-blue);
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 22px;
    }

    .card h3 {
      color: var(--navy);
      margin-bottom: 10px;
    }

    .card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* EXPERIENCE */

    .experience {
      max-width: 900px;
    }

    .job {
      display: grid;
      grid-template-columns: 25px 1fr;
      gap: 25px;
      margin-top: 40px;
    }

    .marker {
      width: 13px;
      height: 13px;
      border: 3px solid var(--blue);
      border-radius: 50%;
      margin-top: 7px;
    }

    .job h3 {
      color: var(--navy);
      font-size: 23px;
      margin-bottom: 5px;
    }

    .job-title {
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 5px;
    }

    .job-subtitle {
      color: var(--muted);
      margin-bottom: 18px;
    }

    .job ul {
      padding-left: 20px;
      color: var(--muted);
    }

    .job li {
      margin-bottom: 8px;
    }

    /* SKILLS */

    .skill-grid {
      display: grid;
      grid-template-columns: repeat(2,1fr);
      gap: 20px;
      margin-top: 40px;
    }

    .skill-box {
      background: white;
      border: 1px solid var(--border);
      padding: 25px;
      border-radius: 10px;
    }

    .skill-box h3 {
      color: var(--navy);
      margin-bottom: 15px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      border: 1px solid var(--border);
      background: #fafcfd;
      border-radius: 30px;
      padding: 7px 12px;
      font-size: 13px;
      color: var(--muted);
    }

    /* CERTIFICATIONS */

    .certifications {
      margin-top: 55px;
      padding-top: 40px;
      border-top: 1px solid var(--border);
    }

    .cert-list {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .certificate {
      background: white;
      border: 1px solid var(--border);
      padding: 15px 20px;
      border-radius: 8px;
      font-weight: 600;
      color: var(--navy);
    }

    /* METRICS */

    .metrics {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 20px;
    }

    .metric {
      padding: 30px;
      background: var(--light);
      border-left: 3px solid var(--blue);
    }

    .metric strong {
      display: block;
      color: var(--navy);
      font-family: Georgia, serif;
      font-size: 38px;
    }

    .metric span {
      color: var(--muted);
      font-size: 14px;
    }

    /* CONTACT */

    .contact {
      background: var(--navy);
      color: white;
    }

    .contact h2 {
      color: white;
    }

    .contact p {
      color: #cbd5e1;
      max-width: 700px;
      margin-bottom: 25px;
    }

    .email {
      display: inline-block;
      padding: 15px 22px;
      background: var(--blue);
      color: white;
      border-radius: 6px;
      font-weight: 700;
    }

    /* FOOTER */

    footer {
      background: #0c1628;
      color: #94a3b8;
      padding: 25px 0;
      font-size: 13px;
      text-align: center;
    }

    /* MOBILE */

    @media(max-width:900px) {
      .hero-grid,
      .two-column {
        grid-template-columns: 1fr;
      }

      .cards {
        grid-template-columns: repeat(2,1fr);
      }

      .hero {
        padding-top: 70px;
      }
    }

    @media(max-width:650px) {
      nav {
        display: none;
      }

      h1 {
        font-size: 46px;
      }

      section {
        padding: 65px 0;
      }

      section h2 {
        font-size: 35px;
      }

      .cards,
      .skill-grid,
      .metrics {
        grid-template-columns: 1fr;
      }

      .profile-card {
        padding: 25px;
      }
    }
  </style>
</head>

